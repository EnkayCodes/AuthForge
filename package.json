{
  "name": "authforge",
  "private": true,
  "version": "0.1.0",
  "engines": { "node": ">=22" },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:api": "pnpm --filter @authforge/api dev",
    "dev:web": "pnpm --filter @authforge/web dev",
    "db:generate": "pnpm --filter @authforge/db generate",
    "db:migrate": "pnpm --filter @authforge/db migrate"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
