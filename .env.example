# API
PORT=4000
NODE_ENV=development

# Database — Supabase hosted Postgres.
# Supabase dashboard > Project Settings > Database > Connection string > URI.
# Use the connection-pooler URI (port 6543) and append pgbouncer=true.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct (non-pooled) connection, port 5432 — required by `prisma migrate`.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Developer session JWT (HS256). Generate with: openssl rand -hex 32
SESSION_JWT_SECRET="replace-with-a-long-random-string"
SESSION_JWT_TTL="7d"
