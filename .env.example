# API
PORT=4000
NODE_ENV=development

# Database — Supabase hosted Postgres.
# Supabase dashboard > Project Settings > Database > Connection string > URI.
# Percent-encode the password if it contains @ : / ? # & = or spaces.
#
# Runtime queries use the transaction pooler (port 6543).
#
# connect_timeout / pool_timeout are raised from Prisma's 5s default. On a
# high-latency link to the pooler, 5s is too tight and surfaces as intermittent
# "Can't reach database server" failures partway through a test run.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connect_timeout=30&pool_timeout=30"

# Migrations use the SESSION pooler (same host, port 5432, no pgbouncer flag).
# Notes:
#   - The dedicated direct host (db.<project-ref>.supabase.co) is IPv6-only on
#     the free plan and is unreachable from IPv4-only networks; use the session
#     pooler instead.
#   - `sslaccept=accept_invalid_certs` keeps TLS on but skips certificate-chain
#     verification, because the pooler's CA is not in the default trust store.
#     Without it Prisma reports a misleading "P1001 can't reach database server".
#
#     This is a deliberate relaxation, scoped to migrations only — the runtime
#     DATABASE_URL above verifies normally. To verify the chain here too, download
#     your project's CA certificate (Supabase dashboard > Database > SSL
#     Configuration) and swap the parameters for:
#         ?sslmode=verify-full&sslcert=./prod-ca.crt
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require&sslaccept=accept_invalid_certs&connect_timeout=30"

# Hosted login page base URL. The /authorize endpoint redirects here so the
# end-user authenticates on AuthForge's own UI before being sent back to the
# consumer app with an authorization code.
LOGIN_BASE_URL="http://localhost:3000"

# Redis — used by BullMQ for the async email worker.
# When set, the API enqueues emails instead of sending them inline; a
# separate worker process (pnpm run worker) picks them up.
# Omit to keep inline console delivery (fine for local dev without Redis).
REDIS_URL="redis://localhost:6379"

# Developer session JWT (HS256). Generate with: openssl rand -hex 32
SESSION_JWT_SECRET="replace-with-a-long-random-string"
SESSION_JWT_TTL="7d"

# RS256 key pair for signing end-user access tokens. The private key signs
# JWTs; the public key is served at /.well-known/jwks.json so consumer apps
# verify tokens independently.
#
# Generate a key pair with:
#   openssl genrsa 2048 | openssl pkcs8 -topk8 -nocrypt -outform PEM
#   openssl rsa -in <private.pem> -pubout
#
# Paste the PEM contents on a single line, replacing newlines with \n.
# If omitted, a key pair is generated in memory at startup (fine for dev,
# but tokens will not survive a restart).
RS256_PRIVATE_KEY=
RS256_PUBLIC_KEY=
RS256_KEY_ID=

# Single-use token lifetimes, in seconds.
# Verification tokens are long-lived because a user may not check mail promptly;
# reset tokens are short because they are a standing account-takeover primitive.
VERIFICATION_TOKEN_TTL_SECONDS=86400
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600

# Google OAuth — "Sign in with Google" on the hosted login page.
# Create credentials at https://console.cloud.google.com/apis/credentials.
# Set the authorized redirect URI to <API_BASE_URL>/oauth/google/callback.
# Omit both to disable Google login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
