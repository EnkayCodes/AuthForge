# API
PORT=4000
NODE_ENV=development

# Database — Supabase hosted Postgres.
# Supabase dashboard > Project Settings > Database > Connection string > URI.
# Percent-encode the password if it contains @ : / ? # & = or spaces.
#
# Runtime queries use the transaction pooler (port 6543).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migrations use the SESSION pooler (same host, port 5432, no pgbouncer flag).
# Notes:
#   - The dedicated direct host (db.<project-ref>.supabase.co) is IPv6-only on
#     the free plan and is unreachable from IPv4-only networks; use the session
#     pooler instead.
#   - `sslaccept=accept_invalid_certs` keeps TLS on but skips certificate-chain
#     verification, because the pooler's CA is not in the default trust store.
#     Without it Prisma reports a misleading "P1001 can't reach database server".
#
#     This is a deliberate relaxation, scoped to migrations only — the runtime
#     DATABASE_URL above verifies normally. To verify the chain here too, download
#     your project's CA certificate (Supabase dashboard > Database > SSL
#     Configuration) and swap the parameters for:
#         ?sslmode=verify-full&sslcert=./prod-ca.crt
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require&sslaccept=accept_invalid_certs"

# Developer session JWT (HS256). Generate with: openssl rand -hex 32
SESSION_JWT_SECRET="replace-with-a-long-random-string"
SESSION_JWT_TTL="7d"
